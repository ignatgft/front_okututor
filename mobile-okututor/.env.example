# Okututor Mobile — Environment Variables
# Copy to .env for development (UPDATED. NEVER COMMIT a real .env).
# Expo auto-loads .env / .env.local / .env.<APP_ENV>. Only EXPO_PUBLIC_* vars
# are inlined into the client bundle — never put server secrets here.

# Backend API base URL (no trailing slash)
EXPO_PUBLIC_API_URL=http://localhost:8080

# App environment: development | staging | production
EXPO_PUBLIC_ENVIRONMENT=development

# Google OAuth authorization URL (optional — falls back to /oauth2/authorization/google)
# EXPO_PUBLIC_GOOGLE_OAUTH_URL=https://accounts.google.com/o/oauth2/v2/auth