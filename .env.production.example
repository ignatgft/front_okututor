# Production template — copy to .env.production and fill in real values.
# Secrets must NEVER be placed here: every VITE_* var is public.

VITE_APP_ENV=production

# Production always uses the real API. Mock cannot be enabled in production builds.
VITE_API_MODE=api

# Backend base URL behind the same origin (nginx proxies /api and /oauth2)
VITE_API_URL=/api
